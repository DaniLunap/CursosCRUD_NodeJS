<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Cursos Académicos</title>
</head>
<body>
    <h1>Gestión de Cursos Académicos</h1>
    <a href="/cursos/nuevo" class="btn btn-outline-success">Añadir nuevo Curso</a> <br>

    <table border="1" class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>NOMBRE CURSO</th>
                <th>INSTRUCTOR</th>
                <th>CRÉDITOS</th>
                <th>CUPO MÁXIMO</th>
                <th>ACCIONES</th> 
            </tr>
        </thead>
        <tbody>
            <% cursos.forEach(c => { %>
            <tr>
                <td><%= c.id %></td>
                <td><%= c.nombre_curso %></td>
                <td><%= c.instructor %></td>
                <td><%= c.creditos %></td>
                <td><%= c.cupo_maximo %></td>
                <td>
                    <a class="btn btn-outline-primary" href="/cursos/editar/<%= c.id %>">Editar</a>
                    
                    <form 
                        action="/cursos/eliminar/<%= c.id %>?_method=DELETE" 
                        method="POST" 
                        style="display: inline;"
                        onsubmit="return confirm('¿Seguro quieres eliminarlo?')">
                        <button class="btn btn-outline-danger" type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>